# Copy to .env and set your own values.
PORT=3001
STUDIO_USERNAME=admin
STUDIO_PASSWORD=change-me-to-something-long
# Where encoders (OBS etc.) push, and where viewers pull HLS from.
RTMP_INGEST_URL=rtmp://localhost:1935/live
HLS_BASE_URL=http://localhost:8080/live
# Postgres connection string. On Railway, reference the Postgres service: ${{Postgres.DATABASE_URL}}
# Leave unset locally to store studio data in node_bk/data/studio.json.
# DATABASE_URL=
